{
	"name": "atlas",
	"version": "0.7.1",
	"description": "A replacement file explorer for Obsidian that arranges units into hierarchies without moving anything on disk.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "Dan Fletcher",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"jsdom": "^26.1.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.6.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
